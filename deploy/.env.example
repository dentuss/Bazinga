# Copy to .env on the server and fill in. Never commit the real .env.
# Used by deploy/docker-compose.yml and scripts/init-letsencrypt.sh.

# ---- Domain + TLS ----------------------------------------------------------
# Apex domain the app is served on (DNS A/AAAA record must point at this EC2).
DOMAIN=bazinga.example.com
# Email Let's Encrypt uses for expiry notices.
LETSENCRYPT_EMAIL=admin@bazinga.example.com
# Set to 1 while testing to hit the Let's Encrypt staging CA (avoids rate
# limits / untrusted-but-issued certs); set to 0 for real certificates.
CERTBOT_STAGING=0

# ---- Container images (from your registry / ECR) ---------------------------
# e.g. 123456789012.dkr.ecr.eu-central-1.amazonaws.com/bazinga-api:latest
API_IMAGE=ghcr.io/dentuss/bazinga-api:latest
CLIENT_IMAGE=ghcr.io/dentuss/bazinga-client:latest

# ---- Runtime ---------------------------------------------------------------
ASPNETCORE_ENVIRONMENT=Production

# ---- AWS RDS for MySQL -----------------------------------------------------
# Pomelo/MySQL connection string pointing at the RDS endpoint. Keep SSL on.
DB_CONNECTION_STRING=Server=bazinga.abcdefxyz.eu-central-1.rds.amazonaws.com;Port=3306;Database=bazinga;User=bazinga_app;Password=CHANGE_ME;SslMode=Required;AllowPublicKeyRetrieval=true

# ---- Security --------------------------------------------------------------
# Long random string (>= 32 chars). Generate: openssl rand -base64 48
JWT_SECRET=CHANGE_ME_to_a_long_random_secret_value

# ---- Email / SMTP (optional; magic links log to stdout if blank) ----------
SMTP_HOST=
SMTP_PORT=587
SMTP_USE_SSL=true
SMTP_USERNAME=
SMTP_PASSWORD=
EMAIL_FROM_NAME=Bazinga
EMAIL_FROM_ADDRESS=no-reply@bazinga.example.com

# ---- Billing / Stripe (optional; mock card form used if blank) ------------
STRIPE_SECRET_KEY=
STRIPE_PUBLISHABLE_KEY=
